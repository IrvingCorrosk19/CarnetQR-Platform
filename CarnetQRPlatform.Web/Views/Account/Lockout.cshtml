@{
    ViewData["Title"] = "Cuenta Bloqueada";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarnetQR Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-5">
                <div class="card shadow">
                    <div class="card-body p-5 text-center">
                        <h2 class="text-danger mb-4">Cuenta Bloqueada</h2>
                        <p class="mb-4">Esta cuenta ha sido bloqueada. Por favor, intente de nuevo más tarde.</p>
                        <a asp-action="Login" class="btn btn-primary">Volver al Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

