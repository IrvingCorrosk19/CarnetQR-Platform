@model CarnetQRPlatform.Domain.Entities.CardTemplate
@{
    ViewData["Title"] = "Nueva Plantilla";
    var availableFields = new List<string> 
    { 
        "IdentificationNumber", 
        "FirstName", 
        "LastName", 
        "Email", 
        "Phone", 
        "DateOfBirth" 
    };
    var selectedFields = Model.VisibleFields ?? new List<string> { "IdentificationNumber", "FirstName", "LastName" };
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-plus-circle me-2"></i>
            Nueva Plantilla de Carnet
        </h3>
    </div>
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Create" method="post" id="createTemplateForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">Nombre de la Plantilla</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <div class="form-check mt-4">
                            <input asp-for="PhotoEnabled" class="form-check-input" type="checkbox" />
                            <label asp-for="PhotoEnabled" class="form-check-label">
                                Habilitar foto en el carnet
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Campos Visibles (máximo 6)</label>
                <div class="row">
                    @foreach (var field in availableFields)
                    {
                        <div class="col-md-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input field-checkbox" type="checkbox" 
                                       name="VisibleFields" value="@field" 
                                       id="field_@field"
                                       @(selectedFields.Contains(field) ? "checked" : "") />
                                <label class="form-check-label" for="field_@field">
                                    @(field == "IdentificationNumber" ? "Número de Identificación" :
                                      field == "FirstName" ? "Nombre" :
                                      field == "LastName" ? "Apellido" :
                                      field == "Email" ? "Email" :
                                      field == "Phone" ? "Teléfono" :
                                      field == "DateOfBirth" ? "Fecha de Nacimiento" : field)
                                </label>
                            </div>
                        </div>
                    }
                </div>
                <small class="form-text text-muted">Seleccione hasta 6 campos para mostrar en el carnet.</small>
                <div id="fieldLimitMessage" class="text-danger mt-2" style="display: none;">
                    <i class="fas fa-exclamation-triangle"></i> Máximo 6 campos permitidos.
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TemplateHtml" class="form-label">Plantilla HTML (opcional)</label>
                <textarea asp-for="TemplateHtml" class="form-control" rows="10" 
                          placeholder="<div class='card-template'>...</div>"></textarea>
                <small class="form-text text-muted">
                    Plantilla HTML personalizada. Use las variables: {{CardNumber}}, {{FirstName}}, {{LastName}}, etc.
                </small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Guardar Plantilla
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var maxFields = 6;
            var checkboxes = $('.field-checkbox');
            
            checkboxes.on('change', function() {
                var checkedCount = checkboxes.filter(':checked').length;
                
                if (checkedCount > maxFields) {
                    $(this).prop('checked', false);
                    $('#fieldLimitMessage').show().fadeOut(3000);
                    return false;
                }
            });

            // Submit form con AJAX
            $('#createTemplateForm').on('submit', function(e) {
                e.preventDefault();
                submitFormAjax(this, {
                    loadingMessage: 'Creando plantilla...',
                    successMessage: 'Plantilla creada exitosamente'
                });
            });
        });
    </script>
}


