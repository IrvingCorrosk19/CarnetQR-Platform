@model IEnumerable<CarnetQRPlatform.Domain.Entities.CardTemplate>
@{
    ViewData["Title"] = "Plantillas de Carnets";
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-palette me-2"></i>
            Plantillas de Carnets
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-light btn-sm">
                <i class="fas fa-plus"></i> Nueva Plantilla
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <table id="templatesTable" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Foto Habilitada</th>
                    <th>Campos Visibles</th>
                    <th>Predeterminada</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                            @if (item.IsDefault)
                            {
                                <span class="badge bg-primary ms-2">Predeterminada</span>
                            }
                        </td>
                        <td>
                            @if (item.PhotoEnabled)
                            {
                                <span class="badge bg-success">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (item.VisibleFields != null && item.VisibleFields.Any())
                            {
                                <span class="badge bg-info">@item.VisibleFields.Count campo(s)</span>
                            }
                            else
                            {
                                <span class="text-muted">Ninguno</span>
                            }
                        </td>
                        <td>
                            @if (item.IsDefault)
                            {
                                <span class="badge bg-primary">Sí</span>
                            }
                            else
                            {
                                <form asp-action="SetAsDefault" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Marcar como Predeterminada</button>
                                </form>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            @if (!item.IsDefault)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline form-delete">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#templatesTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                "responsive": true,
                "pageLength": 25
            });

            // Confirmar eliminación con SweetAlert y AJAX
            $('.form-delete').on('submit', function(e) {
                e.preventDefault();
                var form = this;
                var formAction = $(form).attr('action');
                
                showConfirm('¿Está seguro?', 'Esta acción eliminará la plantilla permanentemente', 'Sí, eliminar', 'Cancelar')
                    .then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: formAction,
                                type: 'POST',
                                data: $(form).serialize(),
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                beforeSend: function(xhr) {
                                    var token = $('input[name="__RequestVerificationToken"]', form).val();
                                    if (token) {
                                        xhr.setRequestHeader('RequestVerificationToken', token);
                                    }
                                    showLoading('Eliminando...');
                                },
                                success: function(response) {
                                    Swal.close();
                                    if (response.success) {
                                        showSuccess('Éxito', response.message)
                                            .then(() => location.reload());
                                    } else {
                                        showError('Error', response.message);
                                    }
                                },
                                error: function(xhr) {
                                    Swal.close();
                                    showError('Error', 'No se pudo eliminar la plantilla.');
                                }
                            });
                        }
                    });
            });

            // Confirmar establecer como predeterminada con AJAX
            $('.form-set-default').on('submit', function(e) {
                e.preventDefault();
                var form = this;
                var formAction = $(form).attr('action');
                
                $.ajax({
                    url: formAction,
                    type: 'POST',
                    data: $(form).serialize(),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    beforeSend: function(xhr) {
                        var token = $('input[name="__RequestVerificationToken"]', form).val();
                        if (token) {
                            xhr.setRequestHeader('RequestVerificationToken', token);
                        }
                        showLoading('Actualizando...');
                    },
                    success: function(response) {
                        Swal.close();
                        if (response.success) {
                            showSuccess('Éxito', response.message)
                                .then(() => location.reload());
                        } else {
                            showError('Error', response.message);
                        }
                    },
                    error: function(xhr) {
                        Swal.close();
                        showError('Error', 'No se pudo actualizar la plantilla.');
                    }
                });
            });
        });
    </script>
}


