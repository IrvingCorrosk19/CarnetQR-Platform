@model CarnetQRPlatform.Domain.Entities.EntityProfile
@{
    ViewData["Title"] = "Detalle de Entidad";
    var cards = ViewBag.Cards as IEnumerable<CarnetQRPlatform.Domain.Entities.Card> ?? Enumerable.Empty<CarnetQRPlatform.Domain.Entities.Card>();
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user me-2"></i>
            Detalle de Entidad
        </h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Identificación:</dt><dd class="col-sm-9">@(Model.IdentificationNumber ?? "-")</dd>
            <dt class="col-sm-3">Nombre:</dt><dd class="col-sm-9">@($"{Model.FirstName} {Model.LastName}")</dd>
            <dt class="col-sm-3">Email:</dt><dd class="col-sm-9">@(Model.Email ?? "-")</dd>
            <dt class="col-sm-3">Teléfono:</dt><dd class="col-sm-9">@(Model.Phone ?? "-")</dd>
            <dt class="col-sm-3">Estado:</dt><dd class="col-sm-9"><span class="badge bg-@(Model.IsActive ? "success" : "secondary")">@(Model.IsActive ? "Activo" : "Inactivo")</span></dd>
        </dl>
        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <form asp-action="GenerateCard" asp-route-entityProfileId="@Model.Id" method="post" class="d-inline" id="generateCardForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Generar Carnet</button>
            </form>
        </div>
    </div>
</div>

<div class="card mt-3 fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-id-card me-2"></i>
            Carnets Asociados
            <span class="badge bg-info ms-2">@cards.Count()</span>
        </h3>
    </div>
    <div class="card-body">
        @if (cards.Any())
        {
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Número de Carnet</th>
                        <th>Token QR</th>
                        <th>Fecha Emisión</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in cards)
                    {
                        <tr>
                            <td><strong>@card.CardNumber</strong></td>
                            <td><code class="text-break">@card.QrToken</code></td>
                            <td>@card.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge bg-@(card.IsActive ? "success" : "secondary")">
                                    @(card.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Cards" asp-action="Details" asp-route-id="@card.Id" class="btn btn-sm btn-info" title="Ver detalles">
                                    <i class="fas fa-eye me-1"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Esta entidad no tiene carnets asociados. Haz clic en "Generar Carnet" para crear uno.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#generateCardForm').on('submit', function(e) {
                e.preventDefault();
                submitFormAjax(this, {
                    loadingMessage: 'Generando carnet...',
                    successMessage: 'Carnet generado exitosamente',
                    successCallback: function() {
                        location.reload(); // Recargar para mostrar el nuevo carnet
                    }
                });
            });
        });
    </script>
}

