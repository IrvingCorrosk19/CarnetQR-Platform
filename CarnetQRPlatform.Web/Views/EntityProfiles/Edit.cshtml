@model CarnetQRPlatform.Domain.Entities.EntityProfile
@using CarnetQRPlatform.Domain.Constants
@{
    ViewData["Title"] = "Editar Entidad";
    var isSuperAdmin = User.IsInRole(Roles.SuperAdmin);
    var institutions = ViewBag.Institutions as IEnumerable<CarnetQRPlatform.Domain.Entities.Institution>;
    var photoEnabled = ViewBag.PhotoEnabled as bool? ?? false;
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-edit me-2"></i>
            Editar Entidad
        </h3>
    </div>
    <form asp-action="Edit" method="post" id="editEntityForm" enctype="multipart/form-data">
        <div class="card-body">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <input type="hidden" id="CurrentPhotoPath" value="@Model.PhotoPath" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            @* Selector de empresa solo para SuperAdmin *@
            @if (isSuperAdmin && institutions != null)
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-4">
                            <label asp-for="InstitutionId" class="form-label">Empresa <span class="text-danger">*</span></label>
                            <select asp-for="InstitutionId" class="form-select" id="InstitutionId" required>
                                <option value="">-- Seleccione una empresa --</option>
                                @foreach (var institution in institutions)
                                {
                                    <option value="@institution.Id" selected="@(Model.InstitutionId == institution.Id)">@institution.Name</option>
                                }
                            </select>
                            <span asp-validation-for="InstitutionId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="InstitutionId" />
            }
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="IdentificationNumber" class="form-label">Número de Identificación</label>
                        <input asp-for="IdentificationNumber" class="form-control" placeholder="Ingrese el número de identificación" />
                        <span asp-validation-for="IdentificationNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="FirstName" class="form-label">Nombre</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ingrese el nombre" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="LastName" class="form-label">Apellido</label>
                        <input asp-for="LastName" class="form-control" placeholder="Ingrese el apellido" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" placeholder="+507 1234-5678" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="DateOfBirth" class="form-label">Fecha de Nacimiento</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mb-4">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">Entidad Activa</label>
                </div>
            </div>
            
            @* Input de foto - SIEMPRE visible para permitir carga de imágenes *@
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group mb-4">
                        <label for="PhotoFile" class="form-label">
                            <i class="fas fa-camera me-2"></i>Foto de la Entidad 
                            <span class="text-muted">(Opcional)</span>
                        </label>
                        @if (!string.IsNullOrEmpty(Model.PhotoPath))
                        {
                            <div class="mb-2" id="currentPhoto">
                                <img src="@Model.PhotoPath" alt="Foto actual" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" id="currentPhotoImg" />
                                <p class="text-muted small mt-1">Foto actual</p>
                            </div>
                        }
                        <input type="file" name="PhotoFile" id="PhotoFile" class="form-control" accept="image/jpeg,image/jpg,image/png,image/gif" />
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Formatos permitidos: JPG, JPEG, PNG, GIF. Tamaño máximo: 5MB. 
                            Deje vacío para mantener la foto actual. Esta foto aparecerá en el carnet.
                        </small>
                        <div id="photoPreview" class="mt-2" style="display:none;">
                            <img id="previewImage" src="" alt="Vista previa de nueva foto" class="img-thumbnail" style="max-width: 200px; max-height: 200px; border: 2px solid #28a745;" />
                            <p class="text-success small mt-1"><i class="fas fa-check-circle me-1"></i>Nueva foto (vista previa) - Se guardará correctamente</p>
                        </div>
                        <span asp-validation-for="PhotoPath" class="text-danger"></span>
                        <div id="photoError" class="text-danger mt-1" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar Cambios
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Vista previa de imagen antes de subir
            $('#PhotoFile').on('change', function(e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#previewImage').attr('src', e.target.result);
                        $('#photoPreview').show();
                        // Ocultar foto actual si hay una nueva
                        if ($('#currentPhoto').length) {
                            $('#currentPhoto').fadeOut(200);
                        }
                    };
                    reader.readAsDataURL(file);
                } else {
                    $('#photoPreview').hide();
                    // Mostrar foto actual si se cancela la selección
                    if ($('#currentPhoto').length) {
                        $('#currentPhoto').fadeIn(200);
                    }
                }
            });

            console.log('🔵 [FRONTEND] Página de edición cargada. EntityId=@Model.Id, IsSuperAdmin=@isSuperAdmin, InstitutionId=@Model.InstitutionId');
            
            @if (isSuperAdmin)
            {
                <text>
                console.log('🔵 [FRONTEND] SuperAdmin detectado. Dropdown de instituciones disponible');
                $('#InstitutionId').on('change', function() {
                    console.log('🔵 [FRONTEND] Institución seleccionada cambiada:', $(this).val(), $(this).find('option:selected').text());
                });
                </text>
            }
            else
            {
                <text>
                var hiddenInstitutionId = $('input[name="InstitutionId"]').val();
                console.log('🔵 [FRONTEND] Usuario no-SuperAdmin. InstitutionId oculto:', hiddenInstitutionId);
                </text>
            }
            
            $('#editEntityForm').on('submit', function(e) {
                e.preventDefault();
                
                console.log('🟢 [FRONTEND] Formulario de edición enviado');
                
                var form = this;
                var formData = new FormData(form);
                
                // Log de todos los datos del formulario
                console.log('🟢 [FRONTEND] Datos del formulario:');
                for (var pair of formData.entries()) {
                    if (pair[0] === 'PhotoFile') {
                        console.log('  -', pair[0] + ':', pair[1].name, '(' + pair[1].size + ' bytes)');
                    } else {
                        console.log('  -', pair[0] + ':', pair[1]);
                    }
                }
                
                @if (isSuperAdmin)
                {
                    <text>
                    // Validar que se haya seleccionado una institución (solo para SuperAdmin)
                    var institutionId = $('#InstitutionId').val();
                    console.log('🟢 [FRONTEND] SuperAdmin - Validando InstitutionId:', institutionId);
                    
                    if (!institutionId || institutionId === '') {
                        console.error('🔴 [FRONTEND] SuperAdmin no seleccionó institución');
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Debe seleccionar una empresa.'
                        });
                        $(form).find('button[type="submit"]').prop('disabled', false).html('<i class="fas fa-save"></i> Guardar Cambios');
                        return false;
                    }
                    console.log('🟢 [FRONTEND] Institución válida seleccionada:', institutionId);
                    </text>
                }
                else
                {
                    <text>
                    // Asegurar que InstitutionId se envíe (para usuarios no-SuperAdmin)
                    var institutionId = $('input[name="InstitutionId"]').val();
                    console.log('🟢 [FRONTEND] Usuario no-SuperAdmin - InstitutionId:', institutionId);
                    
                    if (!institutionId || institutionId === '') {
                        // Si no está en el formData, agregarlo desde el modelo
                        var modelInstitutionId = '@Model.InstitutionId.ToString()';
                        console.log('🟢 [FRONTEND] InstitutionId vacío, agregando desde modelo:', modelInstitutionId);
                        formData.append('InstitutionId', modelInstitutionId);
                    } else {
                        console.log('🟢 [FRONTEND] InstitutionId ya presente en formulario:', institutionId);
                    }
                    </text>
                }
                
                // Validar archivo de foto si se seleccionó uno
                var photoFile = $('#PhotoFile')[0].files[0];
                var photoError = $('#photoError');
                photoError.hide().text('');
                
                if (photoFile) {
                    console.log('🟢 [FRONTEND] Foto seleccionada:', photoFile.name, photoFile.size, 'bytes, tipo:', photoFile.type);
                    
                    // Validar tipo de archivo
                    var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                    if (!allowedTypes.includes(photoFile.type)) {
                        console.error('🔴 [FRONTEND] Tipo de archivo no permitido:', photoFile.type);
                        photoError.text('❌ Solo se permiten archivos de imagen (JPG, JPEG, PNG, GIF).').show();
                        $(form).find('button[type="submit"]').prop('disabled', false).html('<i class="fas fa-save"></i> Guardar Cambios');
                        return false;
                    }
                    
                    // Validar tamaño (5MB máximo)
                    if (photoFile.size > 5 * 1024 * 1024) {
                        console.error('🔴 [FRONTEND] Archivo excede tamaño máximo:', photoFile.size, 'bytes');
                        photoError.text('❌ El archivo no puede exceder 5MB.').show();
                        $(form).find('button[type="submit"]').prop('disabled', false).html('<i class="fas fa-save"></i> Guardar Cambios');
                        return false;
                    }
                    
                    console.log('🟢 [FRONTEND] Foto válida, se enviará al servidor');
                } else {
                    console.log('🟢 [FRONTEND] No se seleccionó nueva foto - se preservará la foto actual');
                }
                
                console.log('🟢 [FRONTEND] Enviando petición AJAX a:', $(form).attr('action'));
                
                // Usar FormData para envío con archivos
                $.ajax({
                    url: $(form).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function() {
                        console.log('🟢 [FRONTEND] Petición AJAX iniciada');
                        // Mostrar loading
                        $(form).find('button[type="submit"]').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Guardando...');
                    },
                    success: function(response) {
                        console.log('🟢 [FRONTEND] Respuesta recibida del servidor:', response);
                        
                        if (response.success) {
                            console.log('✅ [FRONTEND] Actualización exitosa');
                            Swal.fire({
                                icon: 'success',
                                title: '¡Éxito!',
                                text: 'Entidad actualizada exitosamente.',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(function() {
                                window.location.href = response.redirectUrl || '@Url.Action("Index", "EntityProfiles")';
                            });
                        } else {
                            console.error('🔴 [FRONTEND] Error en respuesta:', response.message);
                            var errorMsg = response.message || 'Error al actualizar la entidad';
                            if (response.errors && response.errors.PhotoFile) {
                                photoError.text('❌ ' + response.errors.PhotoFile.join(', ')).show();
                            }
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: errorMsg
                            });
                            $(form).find('button[type="submit"]').prop('disabled', false).html('<i class="fas fa-save"></i> Guardar Cambios');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('🔴 [FRONTEND] Error en petición AJAX:', {
                            status: status,
                            error: error,
                            statusCode: xhr.status,
                            responseText: xhr.responseText
                        });
                        
                        var response = xhr.responseJSON;
                        var errorMsg = response?.message || 'Error al actualizar la entidad';
                        
                        // Mostrar error específico de foto si existe
                        if (response?.errors && response.errors.PhotoFile) {
                            photoError.text('❌ ' + response.errors.PhotoFile.join(', ')).show();
                        } else if (response?.errors) {
                            var allErrors = Object.values(response.errors).flat().join(', ');
                            photoError.text('❌ ' + allErrors).show();
                        }
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: errorMsg
                        });
                        $(form).find('button[type="submit"]').prop('disabled', false).html('<i class="fas fa-save"></i> Guardar Cambios');
                    }
                });
            });
        });
    </script>
}
