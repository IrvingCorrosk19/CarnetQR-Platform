@model CarnetQRPlatform.Domain.Entities.EventRecord
@using CarnetQRPlatform.Domain.Constants
@{
    ViewData["Title"] = "Editar Cita";
    var isSuperAdmin = User.IsInRole(Roles.SuperAdmin);
    var institutions = ViewBag.Institutions as IEnumerable<CarnetQRPlatform.Domain.Entities.Institution>;
    var entityProfiles = ViewBag.EntityProfiles as IEnumerable<CarnetQRPlatform.Domain.Entities.EntityProfile>;
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-calendar-edit me-2"></i>
            Editar Cita
        </h3>
    </div>
    <form asp-action="Edit" method="post" id="editEventForm">
        <div class="card-body">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Solo se pueden editar citas programadas. Las citas completadas no pueden modificarse.
            </div>

            @* Selector de institución solo para SuperAdmin *@
            @if (isSuperAdmin && institutions != null && institutions.Any())
            {
                <div class="form-group mb-4">
                    <label for="InstitutionFilter" class="form-label">Empresa</label>
                    <select id="InstitutionFilter" class="form-select">
                        <option value="">-- Todas las empresas --</option>
                        @foreach (var institution in institutions)
                        {
                            <option value="@institution.Id" selected="@(Model.InstitutionId == institution.Id)">@institution.Name</option>
                        }
                    </select>
                    <small class="form-text text-muted">Seleccione una empresa para filtrar los pacientes.</small>
                </div>
            }

            <div class="form-group mb-4">
                <label asp-for="EntityProfileId" class="form-label">Paciente <span class="text-danger">*</span></label>
                <select asp-for="EntityProfileId" class="form-select" id="EntityProfileId" required>
                    <option value="">-- Seleccione un paciente --</option>
                    @if (entityProfiles != null)
                    {
                        @foreach (var entity in entityProfiles)
                        {
                            <option value="@entity.Id" data-institution-id="@entity.InstitutionId" selected="@(Model.EntityProfileId == entity.Id)">
                                @($"{entity.FirstName} {entity.LastName}")@(!string.IsNullOrEmpty(entity.IdentificationNumber) ? $" - {entity.IdentificationNumber}" : "")
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="EntityProfileId" class="text-danger"></span>
            </div>

            @{
                var doctors = ViewBag.Doctors as IEnumerable<CarnetQRPlatform.Domain.Entities.Doctor>;
            }
            <div class="form-group mb-4">
                <label asp-for="DoctorId" class="form-label">
                    <i class="fas fa-user-md me-2"></i>Médico Asignado
                </label>
                <select asp-for="DoctorId" class="form-select" id="DoctorId" style="font-size: 0.95rem;">
                    <option value="">-- Sin médico asignado (opcional) --</option>
                    @if (doctors != null && doctors.Any())
                    {
                        @foreach (var doctor in doctors)
                        {
                            <option value="@doctor.Id" data-institution-id="@doctor.InstitutionId" selected="@(Model.DoctorId == doctor.Id)">
                                @($"{doctor.FirstName} {doctor.LastName}") | Especialidad: @(doctor.Specialty?.Name ?? "Sin especialidad")
                            </option>
                        }
                    }
                    else
                    {
                        <option value="" disabled>No hay médicos disponibles</option>
                    }
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
                <small class="form-text text-muted">
                    <i class="fas fa-info-circle me-1"></i>Seleccione un médico para asignar a la cita. La especialidad se muestra junto al nombre del médico.
                </small>
                @if (doctors != null && doctors.Any())
                {
                    <div id="selectedDoctorInfo" class="mt-2 p-2 bg-light rounded" style="display: none;">
                        <small class="text-muted">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            <span id="selectedDoctorText"></span>
                        </small>
                    </div>
                }
            </div>

            <div class="form-group mb-4">
                <label asp-for="ScheduledAt" class="form-label">Fecha y Hora Programada <span class="text-danger">*</span></label>
                <input asp-for="ScheduledAt" type="datetime-local" class="form-control" required />
                <span asp-validation-for="ScheduledAt" class="text-danger"></span>
                <small class="form-text text-muted">Seleccione la fecha y hora en que se realizará la cita.</small>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Notes" class="form-label">Notas</label>
                <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Información adicional sobre el evento"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label class="form-label">Estado</label>
                <input type="text" class="form-control" value="@Model.Status" readonly />
                <small class="form-text text-muted">El estado no se puede cambiar desde esta vista. Use el botón de acciones en la lista para cambiar el estado.</small>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar Cambios
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            @if (isSuperAdmin)
            {
                <text>
                // Filtrar pacientes y médicos por institución para SuperAdmin
                $('#InstitutionFilter').on('change', function() {
                    var selectedInstitutionId = $(this).val();
                    var $entitySelect = $('#EntityProfileId');
                    var $doctorSelect = $('#DoctorId');
                    
                    // Filtrar pacientes
                    if (selectedInstitutionId) {
                        $entitySelect.find('option').each(function() {
                            var $option = $(this);
                            var institutionId = $option.data('institution-id');
                            
                            if ($option.val() === '') {
                                $option.show();
                            } else if (institutionId === selectedInstitutionId) {
                                $option.show();
                            } else {
                                $option.hide();
                            }
                        });
                    } else {
                        $entitySelect.find('option').show();
                    }
                    
                    // Filtrar médicos
                    if (selectedInstitutionId) {
                        $doctorSelect.find('option').each(function() {
                            var $option = $(this);
                            var institutionId = $option.data('institution-id');
                            
                            if ($option.val() === '') {
                                $option.show();
                            } else if (institutionId === selectedInstitutionId) {
                                $option.show();
                            } else {
                                $option.hide();
                            }
                        });
                    } else {
                        $doctorSelect.find('option').show();
                    }
                    
                    // Si el paciente seleccionado no coincide con el filtro, limpiar selección
                    var selectedEntityOption = $entitySelect.find('option:selected');
                    if (selectedInstitutionId && selectedEntityOption.data('institution-id') !== selectedInstitutionId) {
                        $entitySelect.val('');
                    }
                    
                    // Si el médico seleccionado no coincide con el filtro, limpiar selección
                    var selectedDoctorOption = $doctorSelect.find('option:selected');
                    if (selectedInstitutionId && selectedDoctorOption.data('institution-id') !== selectedInstitutionId) {
                        $doctorSelect.val('');
                    }
                });
                </text>
            }
            
            // Filtrar médicos cuando se selecciona un paciente (para usuarios no-SuperAdmin)
            @if (!isSuperAdmin)
            {
                <text>
                $('#EntityProfileId').on('change', function() {
                    var selectedEntityId = $(this).val();
                    var $doctorSelect = $('#DoctorId');
                    
                    if (selectedEntityId) {
                        // Obtener la institución del paciente seleccionado
                        var selectedOption = $(this).find('option:selected');
                        var entityInstitutionId = selectedOption.data('institution-id');
                        
                        // Filtrar médicos por institución
                        $doctorSelect.find('option').each(function() {
                            var $option = $(this);
                            var doctorInstitutionId = $option.data('institution-id');
                            
                            if ($option.val() === '') {
                                $option.show();
                            } else if (doctorInstitutionId === entityInstitutionId) {
                                $option.show();
                            } else {
                                $option.hide();
                            }
                        });
                        
                        // Si el médico seleccionado no coincide con la institución del paciente, limpiar selección
                        var selectedDoctorOption = $doctorSelect.find('option:selected');
                        if (selectedDoctorOption.data('institution-id') !== entityInstitutionId) {
                            $doctorSelect.val('');
                        }
                    } else {
                        // Mostrar todos los médicos si no hay paciente seleccionado
                        $doctorSelect.find('option').show();
                    }
                });
                </text>
            }
            
            $('#editEventForm').on('submit', function(e) {
                e.preventDefault();
                submitFormAjax(this, {
                    loadingMessage: 'Actualizando cita...',
                    successMessage: 'Cita actualizada exitosamente',
                    redirectUrl: '@Url.Action("Index", "Events")'
                });
            });
        });
    </script>
}

