@{
    ViewData["Title"] = "Dashboard";
}

@if (User.IsInRole("SuperAdmin"))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <strong><i class="fas fa-building me-2"></i>Acceso Rápido:</strong>
        <a href="@Url.Action("Index", "Institutions")" class="alert-link ms-2">
            <i class="fas fa-arrow-right me-1"></i>Ir a Gestión de Empresas
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>150</h3>
                <p>Total Entidades</p>
            </div>
            <div class="icon">
                <i class="fas fa-users"></i>
            </div>
            <a href="@Url.Action("Index", "EntityProfiles")" class="small-box-footer">
                Más información <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>145</h3>
                <p>Carnets Activos</p>
            </div>
            <div class="icon">
                <i class="fas fa-id-card"></i>
            </div>
            <a href="@Url.Action("Index", "Cards")" class="small-box-footer">
                Más información <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>25</h3>
                <p>Eventos Programados</p>
            </div>
            <div class="icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <a href="@Url.Action("Index", "Events")" class="small-box-footer">
                Más información <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>85%</h3>
                <p>Tasa de Cumplimiento</p>
            </div>
            <div class="icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <a href="@Url.Action("Index", "Statistics")" class="small-box-footer">
                Más información <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card fade-in">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-clock me-2"></i>
                    Actividad Reciente
                </h3>
            </div>
            <div class="card-body">
                <p class="text-muted">Actividad reciente de eventos y carnets aparecerá aquí.</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card fade-in">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-calendar-check me-2"></i>
                    Eventos Próximos
                </h3>
            </div>
            <div class="card-body">
                <p class="text-muted">Listado de eventos próximos aparecerá aquí.</p>
            </div>
        </div>
    </div>
</div>
