@model CarnetQRPlatform.Domain.Entities.Institution
@{
    ViewData["Title"] = "Editar Datos de la Institución";
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-edit me-2"></i>
            Editar Datos de la Institución
        </h3>
    </div>
    <form asp-action="Edit" method="post" id="editInstitutionForm" enctype="multipart/form-data">
        <div class="card-body">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label">Nombre de la Institución <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ingrese el nombre de la institución" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descripción de la institución"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="correo@institucion.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" placeholder="+507 1234-5678" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Address" class="form-label">Dirección</label>
                <input asp-for="Address" class="form-control" placeholder="Dirección completa de la institución" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3"><i class="fas fa-image me-2"></i>Logo de la Institución</h5>
            
            @if (!string.IsNullOrEmpty(Model.LogoPath))
            {
                <div class="mb-3">
                    <label class="form-label">Logo Actual</label>
                    <div>
                        <img src="@Model.LogoPath" alt="Logo" style="max-height: 100px; max-width: 200px; border: 1px solid #dee2e6; padding: 5px; border-radius: 4px;" />
                    </div>
                </div>
            }
            
            <div class="form-group mb-4">
                <label for="logoFile" class="form-label">Subir Nuevo Logo</label>
                <input type="file" name="logoFile" id="logoFile" class="form-control" accept="image/*" />
                <small class="form-text text-muted">
                    Formatos permitidos: JPG, PNG, GIF, SVG. Tamaño máximo: 5MB.
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <text><br />Si sube un nuevo logo, el anterior será reemplazado.</text>
                    }
                </small>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Nota:</strong> Los siguientes campos no pueden ser modificados desde aquí:
                <ul class="mb-0 mt-2">
                    <li>Prefijo de Carnet (definido al crear la institución)</li>
                    <li>Tipo de Institución (Clínica/Hospital)</li>
                    <li>Estado de la Institución (Activa/Inactiva)</li>
                </ul>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar Cambios
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#editInstitutionForm').on('submit', function(e) {
                e.preventDefault();
                
                var form = this;
                var formData = new FormData(form);
                
                // Usar FormData para envío con archivos
                $.ajax({
                    url: $(form).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    beforeSend: function() {
                        // Mostrar loading
                    },
                    success: function(response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl || '@Url.Action("Index", "InstitutionConfig")';
                        } else {
                            alert(response.message || 'Error al actualizar los datos');
                        }
                    },
                    error: function(xhr) {
                        var response = xhr.responseJSON;
                        alert(response?.message || 'Error al actualizar los datos');
                    }
                });
            });
        });
    </script>
}

