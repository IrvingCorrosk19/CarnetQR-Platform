@model CarnetQRPlatform.Domain.Entities.Institution
@{
    ViewData["Title"] = "Configuración del QR Público";
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-qrcode me-2"></i>
            Configuración del QR Público
        </h3>
        <div class="card-tools">
            <a href="@Url.Action("Index", "InstitutionConfig")" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>
    <form asp-action="QrPublicSettings" method="post" id="qrPublicSettingsForm">
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="alert alert-info">
                <h6><i class="fas fa-info-circle me-2"></i>Información</h6>
                <p class="mb-0">
                    Esta información se mostrará automáticamente cuando alguien escanee el código QR del carnet.
                    Puede incluir teléfono, dirección, indicaciones especiales, horarios de atención, etc.
                </p>
            </div>

            <div class="form-group mb-4">
                <label for="instructions" class="form-label"><strong>Información Fija para QR Público</strong></label>
                <textarea class="form-control" id="instructions" name="instructions" rows="8" placeholder="Ejemplo:&#10;&#10;Teléfono: +507 1234-5678&#10;Dirección: Calle Principal, Ciudad&#10;&#10;Horarios de Atención:&#10;Lunes a Viernes: 8:00 AM - 5:00 PM&#10;Sábados: 8:00 AM - 12:00 PM&#10;&#10;Indicaciones:&#10;Presentarse 15 minutos antes de su cita.&#10;Traer documento de identidad.">@Model.Instructions</textarea>
                <small class="form-text text-muted">
                    Esta información se mostrará en la vista pública del QR. Puede usar saltos de línea para organizar la información.
                </small>
            </div>

            <div class="card bg-light">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-eye me-2"></i>Vista Previa</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-0">
                        <div id="previewContent" style="white-space: pre-line;">@(Model.Instructions ?? "La información aparecerá aquí...")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar Configuración
            </button>
            <a href="@Url.Action("Index", "InstitutionConfig")" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Actualizar vista previa en tiempo real
            $('#instructions').on('input', function() {
                var content = $(this).val() || 'La información aparecerá aquí...';
                $('#previewContent').text(content);
            });

            // Submit form
            $('#qrPublicSettingsForm').on('submit', function(e) {
                e.preventDefault();
                submitFormAjax(this, {
                    loadingMessage: 'Guardando configuración...',
                    successMessage: 'Configuración guardada exitosamente',
                    redirectUrl: '@Url.Action("QrPublicSettings", "InstitutionConfig")'
                });
            });
        });
    </script>
}

