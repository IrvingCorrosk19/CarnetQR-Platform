@model CarnetQRPlatform.Domain.Entities.Institution
@{
    ViewData["Title"] = "Editar Empresa";
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-edit me-2"></i>
            Editar Empresa
        </h3>
    </div>
    <form asp-action="Edit" method="post" id="editInstitutionForm" enctype="multipart/form-data">
        <div class="card-body">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label">Nombre de la Empresa</label>
                        <input asp-for="Name" class="form-control" placeholder="Ingrese el nombre de la empresa" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="CardPrefix" class="form-label">Prefijo de Carnet</label>
                        <input asp-for="CardPrefix" class="form-control" maxlength="10" readonly />
                        <span asp-validation-for="CardPrefix" class="text-danger"></span>
                        <small class="form-text text-muted">El prefijo no puede modificarse después de crear la empresa.</small>
                    </div>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descripción de la empresa"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="correo@empresa.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-4">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" placeholder="+507 1234-5678" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-4">
                        <label asp-for="InstitutionTypeId" class="form-label">
                            Tipo de Institución
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#institutionTypeModal" title="Gestionar Tipos">
                                <i class="fas fa-cog"></i>
                            </button>
                        </label>
                        <select asp-for="InstitutionTypeId" class="form-control" id="InstitutionTypeId" required>
                            <option value="">-- Seleccione un tipo --</option>
                            @if (ViewBag.InstitutionTypes != null)
                            {
                                @foreach (var type in (List<CarnetQRPlatform.Domain.Entities.InstitutionType>)ViewBag.InstitutionTypes)
                                {
                                    <option value="@type.Id" selected="@(Model.InstitutionTypeId == type.Id)">@type.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="InstitutionTypeId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Address" class="form-label">Dirección</label>
                <input asp-for="Address" class="form-control" placeholder="Dirección completa" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3"><i class="fas fa-image me-2"></i>Logo de la Institución</h5>
            
            @if (!string.IsNullOrEmpty(Model.LogoPath))
            {
                <div class="mb-3">
                    <label class="form-label">Logo Actual</label>
                    <div>
                        <img src="@Model.LogoPath" alt="Logo" style="max-height: 100px; max-width: 200px; border: 1px solid #dee2e6; padding: 5px; border-radius: 4px;" />
                    </div>
                </div>
            }
            
            <div class="form-group mb-4">
                <label for="logoFile" class="form-label">Subir Nuevo Logo</label>
                <input type="file" name="logoFile" id="logoFile" class="form-control" accept="image/*" />
                <small class="form-text text-muted">
                    Formatos permitidos: JPG, PNG, GIF, SVG. Tamaño máximo: 5MB.
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <text><br />Si sube un nuevo logo, el anterior será reemplazado.</text>
                    }
                </small>
            </div>

            <div class="form-group mb-4">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">Empresa Activa</label>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar Cambios
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

<!-- Modal para Gestionar Tipos de Institución -->
<div class="modal fade" id="institutionTypeModal" tabindex="-1" aria-labelledby="institutionTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="institutionTypeModalLabel">
                    <i class="fas fa-building me-2"></i>Gestionar Tipos de Institución
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" id="btnNewType">
                        <i class="fas fa-plus me-2"></i>Nuevo Tipo
                    </button>
                </div>
                
                <div id="typeListContainer">
                    <table class="table table-striped" id="typesTable">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="typesTableBody">
                            <tr>
                                <td colspan="4" class="text-center">
                                    <i class="fas fa-spinner fa-spin"></i> Cargando...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Formulario para Crear/Editar -->
                <div id="typeFormContainer" style="display:none;">
                    <hr />
                    <form id="typeForm">
                        <input type="hidden" id="typeId" />
                        <div class="mb-3">
                            <label for="typeName" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="typeName" required maxlength="100" />
                        </div>
                        <div class="mb-3">
                            <label for="typeDescription" class="form-label">Descripción</label>
                            <textarea class="form-control" id="typeDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="typeIsActive" checked>
                                <label class="form-check-label" for="typeIsActive">
                                    Activo
                                </label>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" id="btnCancelType">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('#editInstitutionForm').on('submit', function(e) {
                e.preventDefault();
                submitFormAjax(this, {
                    loadingMessage: 'Actualizando empresa...',
                    successMessage: 'Empresa actualizada exitosamente'
                });
            });

            // Cargar tipos cuando se abre el modal
            $('#institutionTypeModal').on('show.bs.modal', function() {
                loadInstitutionTypes();
            });

            // Botón nuevo tipo
            $('#btnNewType').on('click', function() {
                resetTypeForm();
                $('#typeFormContainer').slideDown();
                $('#btnNewType').hide();
            });

            // Botón cancelar formulario
            $('#btnCancelType').on('click', function() {
                $('#typeFormContainer').slideUp();
                $('#btnNewType').show();
                resetTypeForm();
            });

            // Submit del formulario
            $('#typeForm').on('submit', function(e) {
                e.preventDefault();
                saveInstitutionType();
            });

            function loadInstitutionTypes() {
                $.ajax({
                    url: '/api/InstitutionTypes',
                    type: 'GET',
                    success: function(types) {
                        var tbody = $('#typesTableBody');
                        tbody.empty();
                        
                        if (types.length === 0) {
                            tbody.append('<tr><td colspan="4" class="text-center text-muted">No hay tipos de institución registrados.</td></tr>');
                            return;
                        }

                        types.forEach(function(type) {
                            var statusBadge = type.isActive 
                                ? '<span class="badge bg-success">Activo</span>' 
                                : '<span class="badge bg-secondary">Inactivo</span>';
                            
                            var row = '<tr data-id="' + type.id + '">' +
                                '<td>' + type.name + '</td>' +
                                '<td>' + (type.description || '-') + '</td>' +
                                '<td>' + statusBadge + '</td>' +
                                '<td>' +
                                    '<button class="btn btn-sm btn-primary edit-type-btn" data-id="' + type.id + '" title="Editar">' +
                                        '<i class="fas fa-edit"></i>' +
                                    '</button> ' +
                                    '<button class="btn btn-sm ' + (type.isActive ? 'btn-warning' : 'btn-success') + ' toggle-type-btn" data-id="' + type.id + '" data-active="' + type.isActive + '" title="' + (type.isActive ? 'Desactivar' : 'Activar') + '">' +
                                        '<i class="fas fa-' + (type.isActive ? 'ban' : 'check') + '"></i>' +
                                    '</button> ' +
                                    '<button class="btn btn-sm btn-danger delete-type-btn" data-id="' + type.id + '" data-name="' + type.name + '" title="Eliminar">' +
                                        '<i class="fas fa-trash"></i>' +
                                    '</button>' +
                                '</td>' +
                                '</tr>';
                            tbody.append(row);
                        });
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudieron cargar los tipos de institución.'
                        });
                    }
                });
            }

            function resetTypeForm() {
                $('#typeId').val('');
                $('#typeName').val('');
                $('#typeDescription').val('');
                $('#typeIsActive').prop('checked', true);
            }

            function saveInstitutionType() {
                var typeData = {
                    id: $('#typeId').val() || '00000000-0000-0000-0000-000000000000',
                    name: $('#typeName').val(),
                    description: $('#typeDescription').val(),
                    isActive: $('#typeIsActive').is(':checked')
                };

                var url = '/api/InstitutionTypes';
                var method = $('#typeId').val() ? 'PUT' : 'POST';

                $.ajax({
                    url: url + (method === 'PUT' ? '/' + $('#typeId').val() : ''),
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(typeData),
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Guardado!',
                                text: response.message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                            $('#typeFormContainer').slideUp();
                            $('#btnNewType').show();
                            resetTypeForm();
                            loadInstitutionTypes();
                            loadTypesForSelect();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message
                            });
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = 'Error al guardar el tipo de institución.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: errorMsg
                        });
                    }
                });
            }

            function loadTypesForSelect() {
                $.ajax({
                    url: '/api/InstitutionTypes',
                    type: 'GET',
                    success: function(types) {
                        var select = $('#InstitutionTypeId');
                        var currentValue = select.val();
                        select.empty();
                        select.append('<option value="">-- Seleccione un tipo --</option>');
                        
                        types.filter(t => t.isActive).forEach(function(type) {
                            var option = $('<option></option>')
                                .attr('value', type.id)
                                .text(type.name);
                            if (type.id === currentValue) {
                                option.attr('selected', 'selected');
                            }
                            select.append(option);
                        });
                    }
                });
            }

            // Editar tipo
            $(document).on('click', '.edit-type-btn', function() {
                var typeId = $(this).data('id');
                $.ajax({
                    url: '/api/InstitutionTypes/' + typeId,
                    type: 'GET',
                    success: function(type) {
                        $('#typeId').val(type.id);
                        $('#typeName').val(type.name);
                        $('#typeDescription').val(type.description || '');
                        $('#typeIsActive').prop('checked', type.isActive);
                        $('#typeFormContainer').slideDown();
                        $('#btnNewType').hide();
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'No se pudo cargar el tipo de institución.'
                        });
                    }
                });
            });

            // Toggle activo/inactivo
            $(document).on('click', '.toggle-type-btn', function() {
                var typeId = $(this).data('id');
                var isActive = $(this).data('active');
                
                $.ajax({
                    url: '/api/InstitutionTypes/' + typeId + '/toggle-active',
                    type: 'POST',
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Actualizado!',
                                text: response.message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                            loadInstitutionTypes();
                            loadTypesForSelect();
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = 'Error al actualizar el estado.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: errorMsg
                        });
                    }
                });
            });

            // Eliminar tipo
            $(document).on('click', '.delete-type-btn', function() {
                var typeId = $(this).data('id');
                var typeName = $(this).data('name');
                
                Swal.fire({
                    title: '¿Estás seguro?',
                    html: `¿Deseas eliminar el tipo de institución <strong>${typeName}</strong>?<br><br>Esta acción no se puede deshacer.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/api/InstitutionTypes/' + typeId,
                            type: 'DELETE',
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: '¡Eliminado!',
                                        text: response.message,
                                        timer: 2000,
                                        showConfirmButton: false
                                    });
                                    loadInstitutionTypes();
                                    loadTypesForSelect();
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: response.message
                                    });
                                }
                            },
                            error: function(xhr) {
                                var errorMsg = 'Error al eliminar el tipo de institución.';
                                if (xhr.responseJSON && xhr.responseJSON.message) {
                                    errorMsg = xhr.responseJSON.message;
                                }
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: errorMsg
                                });
                            }
                        });
                    }
                });
            });
        });
    </script>
}
