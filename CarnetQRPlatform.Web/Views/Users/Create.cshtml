@model CarnetQRPlatform.Web.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
    var institutions = ViewBag.Institutions as IEnumerable<CarnetQRPlatform.Domain.Entities.Institution>;
    var availableRoles = ViewBag.AvailableRoles as string[];
}

<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-plus me-2"></i>
            Nuevo Usuario
        </h3>
    </div>
    <form asp-action="Create" method="post" id="createUserForm">
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Email" class="form-label">Correo Electrónico <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="usuario@ejemplo.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Role" class="form-label">Rol <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select" id="roleSelect" required>
                            <option value="">-- Seleccione un rol --</option>
                            @if (availableRoles != null)
                            {
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="FirstName" class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ingrese el nombre" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="LastName" class="form-label">Apellido <span class="text-danger">*</span></label>
                        <input asp-for="LastName" class="form-control" placeholder="Ingrese el apellido" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Password" class="form-label">Contraseña <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Mínimo 8 caracteres" required />
                        <small class="form-text text-muted">Debe tener al menos 8 caracteres, mayúsculas, minúsculas, números y símbolos.</small>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repita la contraseña" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row" id="institutionRow">
                <div class="col-md-12">
                    <div class="form-group mb-4">
                        <label asp-for="InstitutionId" class="form-label">Empresa <span class="text-danger">*</span></label>
                        <select asp-for="InstitutionId" class="form-select" id="institutionSelect">
                            <option value="">-- Seleccione una empresa --</option>
                            @if (institutions != null)
                            {
                                @foreach (var institution in institutions)
                                {
                                    <option value="@institution.Id">@institution.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="InstitutionId" class="text-danger"></span>
                        <small class="form-text text-muted">El usuario será asignado a esta empresa y solo podrá gestionar sus datos.</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Crear Usuario
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Mostrar/ocultar selector de empresa según el rol
            $('#roleSelect').on('change', function() {
                var role = $(this).val();
                if (role === 'SuperAdmin') {
                    $('#institutionRow').hide();
                    $('#institutionSelect').val('').removeAttr('required');
                } else {
                    $('#institutionRow').show();
                    $('#institutionSelect').attr('required', 'required');
                }
            });

            // Trigger inicial
            $('#roleSelect').trigger('change');

            $('#createUserForm').on('submit', function(e) {
                e.preventDefault();
                submitFormAjax(this, {
                    loadingMessage: 'Creando usuario...',
                    successMessage: 'Usuario creado exitosamente',
                    redirectUrl: '@Url.Action("Index", "Users")'
                });
            });
        });
    </script>
}

